# Server configuration (set real secrets in Settings > Secrets or runtime environment; never commit secrets)
PORT=3000
GEMINI_API_KEY=

# Firebase Admin Dashboard allowlist (strictly limited to authorized agency owner emails)
ADMIN_ALLOWED_EMAILS=audiwisdom@gmail.com,wisdomaudiuniverse@gmail.com

# Agency Gmail notification recipient (also used as Reply-To for customer emails)
LEAD_NOTIFY_TO=wisdomaudiuniverse@gmail.com

# Option A: Gmail SMTP (agency Gmail sender identity)
# Set GMAIL_SMTP_APP_PASSWORD securely in server Secrets (never commit credentials)
GMAIL_SMTP_USER=wisdomaudiuniverse@gmail.com
GMAIL_SMTP_APP_PASSWORD=

# Option B: Resend HTTPS API
# REQUIRED FOR RESEND: Set RESEND_FROM to a sender on your verified Wisdom Audi Universe domain
# (e.g. "Wisdom Audi Universe <hello@yourdomain.com>"). Do not use onboarding@resend.dev for public customer delivery.
RESEND_API_KEY=
RESEND_FROM=

# Option C: Generic SMTP relay (used if Resend verified domain and Gmail SMTP are not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Data retention in days (accepts integer like 90 or "90 days"; default: 365)
LEAD_RETENTION_DAYS=90
